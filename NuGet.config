<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <!-- Opzionale: feed privato del progetto. Evita sorgenti HTTP (allowInsecureConnections) se possibile.
        <add key="NomeFeed" value="https://feed.example.com/v3/index.json" />
        -->
    </packageSources>

    <!-- Package source mapping (security.md, "Supply chain"): ogni pacchetto, anche transitivo, ha una sola fonte.
         Con un feed privato, aggiungere il suo packageSource con i prefissi dei pacchetti interni (più specifici di "*"). -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <!--
        <packageSource key="NomeFeed">
            <package pattern="Prefisso.Pacchetti*" />
        </packageSource>
        -->
    </packageSourceMapping>

    <config>
        <!-- esempio: personalizzare la cartella dei pacchetti (opzionale) -->
        <!-- <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" /> -->
    </config>
</configuration>
